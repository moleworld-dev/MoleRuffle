<?xml version="1.0" encoding="utf-8"?>
<!-- MoleRuffle:虚拟方向键/空格按钮背景。深灰半透明,按下高亮。对应 iOS RGBA(0.10,0.10,0.14,0.55)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC3A3A55" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8C1A1A24" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
